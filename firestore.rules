rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isBarber() {
      return signedIn()
        && userProfile().data.role == "barber";
    }

    // Existing Ari Cohen barber accounts predate multi-tenancy. Keeping this
    // fallback makes the migration backwards-compatible until shopId is added.
    function barberShopId() {
      return userProfile().data.keys().hasAny(["shopId"])
        ? userProfile().data.shopId
        : "ari-cohen";
    }

    function dataShopId(data) {
      return data.keys().hasAny(["shopId"])
        ? data.shopId
        : "ari-cohen";
    }

    function barberOwnsShop(shopId) {
      return isBarber() && barberShopId() == shopId;
    }

    function barberOwnsData(data) {
      return isBarber() && barberShopId() == dataShopId(data);
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == "client";
      allow read: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["name", "phone", "updatedAt"]);
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if signedIn();
      allow create, update, delete: if barberOwnsShop(businessId);
    }

    match /appointments/{appointmentId} {
      allow read: if barberOwnsData(resource.data)
        || (signedIn() && resource.data.clientId == request.auth.uid);

      allow create: if barberOwnsData(request.resource.data)
        || (signedIn()
          && request.resource.data.clientId == request.auth.uid
          && request.resource.data.status == "confirmed"
          && getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.appointmentId == appointmentId
          && dataShopId(getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data) == dataShopId(request.resource.data));

      allow update: if (barberOwnsData(resource.data)
          && dataShopId(request.resource.data) == dataShopId(resource.data))
        || (signedIn()
          && resource.data.clientId == request.auth.uid
          && request.resource.data.clientId == resource.data.clientId
          && dataShopId(request.resource.data) == dataShopId(resource.data)
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"]));

      allow delete: if barberOwnsData(resource.data);
    }

    match /availability/{slotId} {
      allow read: if signedIn();

      allow create: if barberOwnsData(request.resource.data)
        || (signedIn()
          && request.resource.data.status == "booked"
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.clientId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotId == slotId
          && dataShopId(getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data) == dataShopId(request.resource.data));

      allow update: if barberOwnsData(resource.data)
        && dataShopId(request.resource.data) == dataShopId(resource.data);

      allow delete: if barberOwnsData(resource.data)
        || (signedIn()
          && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.clientId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == "cancelled");
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }

    match /gallery/{photoId} {
      allow read: if signedIn();
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }

    match /broadcasts/{messageId} {
      allow read: if barberOwnsData(resource.data);
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }
  }
}
