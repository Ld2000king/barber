rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function admin() {
      return signedIn() && request.auth.token.email == "liavdimri12@gmail.com";
    }

    function isBarber() {
      return signedIn() && userProfile().data.role == "barber";
    }

    // A barber whose account has been approved and not later suspended.
    function activeBarber() {
      return isBarber()
        && userProfile().data.get("status", "approved") == "approved";
    }

    function userShopId() {
      return userProfile().data.keys().hasAny(["shopId"])
        ? userProfile().data.shopId
        : "ari-cohen";
    }

    function dataShopId(data) {
      return data.keys().hasAny(["shopId"])
        ? data.shopId
        : "ari-cohen";
    }

    function belongsToUserShop(data) {
      return signedIn() && userShopId() == dataShopId(data);
    }

    function barberOwnsShop(shopId) {
      return activeBarber() && userShopId() == shopId;
    }

    function barberOwnsData(data) {
      return activeBarber() && userShopId() == dataShopId(data);
    }

    // The client holding a swap listing: by account, or by the phone the
    // barber booked the appointment under (such bookings have no clientId).
    function swapHolder(data) {
      return signedIn()
        && ((data.ownerId != "" && data.ownerId == request.auth.uid)
          || (data.ownerPhone != "" && data.ownerPhone == userProfile().data.get("phone", "")));
    }

    match /barberCodes/{code} {
      // Shop codes are intentionally readable before login so a new client can
      // resolve the correct shop before creating their account.
      allow read: if true;
      // A random code can only be claimed once, by the barber who owns that shop.
      allow create: if signedIn()
        && isBarber()
        && userProfile().data.get("status", "approved") == "approved"
        && request.resource.data.shopId == userShopId()
        && !exists(/databases/$(database)/documents/barberCodes/$(code));
      allow update: if false;
      allow delete: if activeBarber() && resource.data.shopId == userShopId();
    }

    match /users/{userId} {
      // TESTING: self-service signup can create either a client or barber.
      // A new barber account always starts in "pending" status and only an
      // admin-approved account may claim a barber code or open a business.
      allow create: if isOwner(userId)
        && request.resource.data.role in ["client", "barber"]
        && request.resource.data.keys().hasAll(["shopId"])
        && request.resource.data.shopId is string
        && request.resource.data.shopId.size() >= 3
        && (request.resource.data.role == "barber"
          ? (request.resource.data.keys().hasAll(["status"])
            && request.resource.data.status == "pending")
          : (request.resource.data.keys().hasAll(["barberCode"])
            && exists(/databases/$(database)/documents/barberCodes/$(request.resource.data.barberCode))
            && get(/databases/$(database)/documents/barberCodes/$(request.resource.data.barberCode)).data.shopId == request.resource.data.shopId));
      allow read: if isOwner(userId) || admin();
      allow update: if (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && dataShopId(request.resource.data) == dataShopId(resource.data)
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["name", "phone", "updatedAt"])
            || (
              resource.data.role == "barber"
              && !resource.data.keys().hasAny(["barberCode"])
              && request.resource.data.keys().hasAll(["barberCode"])
              && request.resource.data.barberCode is string
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["barberCode", "updatedAt"])
            )
          )
        ) || (
          // The admin may move any barber account between approved / rejected
          // / suspended (approve a request, or suspend / re-activate a shop).
          admin()
          && resource.data.role == "barber"
          && request.resource.data.status in ["approved", "rejected", "suspended"]
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"])
        );
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if admin() || (signedIn() && userShopId() == businessId);
      // A shop can only be created once its owning barber account is approved.
      allow create: if barberOwnsShop(businessId)
        && userProfile().data.get("status", "approved") == "approved";
      allow update, delete: if barberOwnsShop(businessId);
    }

    match /shopApprovals/{uid} {
      // Written by a barber at signup, reviewed only by the admin.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == "pending";
      allow read: if admin() || isOwner(uid);
      allow update: if admin()
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "reviewedAt"]);
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if admin()
        || barberOwnsData(resource.data)
        || (signedIn()
          && resource.data.clientId == request.auth.uid
          && belongsToUserShop(resource.data));

      allow create: if barberOwnsData(request.resource.data)
        || (signedIn()
          && request.resource.data.clientId == request.auth.uid
          && belongsToUserShop(request.resource.data)
          && request.resource.data.status == "confirmed"
          && getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data.appointmentId == appointmentId
          && dataShopId(getAfter(/databases/$(database)/documents/availability/$(request.resource.data.slotId)).data) == userShopId());

      allow update: if (barberOwnsData(resource.data)
          && dataShopId(request.resource.data) == dataShopId(resource.data))
        // The holder of a listed appointment approves a pending swap request.
        // The slot stays booked; the new client must be exactly the requester
        // on file, and the same batch must close the listing as taken by them.
        || (signedIn()
          && belongsToUserShop(resource.data)
          && resource.data.status == "confirmed"
          && (resource.data.clientId == request.auth.uid
            || (resource.data.clientPhone != "" && resource.data.clientPhone == userProfile().data.get("phone", "")))
          && request.resource.data.status == "confirmed"
          && dataShopId(request.resource.data) == dataShopId(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["clientId", "clientName", "clientPhone", "clientEmail", "updatedAt"])
          && get(/databases/$(database)/documents/swaps/$(appointmentId)).data.status == "requested"
          && get(/databases/$(database)/documents/swaps/$(appointmentId)).data.requestedBy == request.resource.data.clientId
          && getAfter(/databases/$(database)/documents/swaps/$(appointmentId)).data.status == "taken"
          && getAfter(/databases/$(database)/documents/swaps/$(appointmentId)).data.takenBy == request.resource.data.clientId)
        || (signedIn()
          && resource.data.clientId == request.auth.uid
          && belongsToUserShop(resource.data)
          && request.resource.data.clientId == resource.data.clientId
          && dataShopId(request.resource.data) == dataShopId(resource.data)
          && request.resource.data.status == "cancelled"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"]));

      allow delete: if barberOwnsData(resource.data);
    }

    match /availability/{slotId} {
      allow read: if admin() || (signedIn() && belongsToUserShop(resource.data));

      allow create: if barberOwnsData(request.resource.data)
        || (signedIn()
          && belongsToUserShop(request.resource.data)
          && request.resource.data.status == "booked"
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.clientId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotId == slotId
          && dataShopId(getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data) == userShopId());

      allow update: if barberOwnsData(resource.data)
        && dataShopId(request.resource.data) == dataShopId(resource.data);

      allow delete: if barberOwnsData(resource.data)
        || (signedIn()
          && belongsToUserShop(resource.data)
          && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.clientId == request.auth.uid
          && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == "cancelled");
    }

    // "מתאים לך?" — the swap board. A listing is keyed by the appointment it
    // offers, so one appointment can never be listed twice.
    match /swaps/{appointmentId} {
      allow read: if admin() || (signedIn() && belongsToUserShop(resource.data));

      allow create: if request.resource.data.status == "open"
        && request.resource.data.appointmentId == appointmentId
        && dataShopId(request.resource.data) == userShopId()
        && (
          // The barber may list any appointment in their own shop.
          barberOwnsData(request.resource.data)
          // A client may only list an appointment that is theirs.
          || (signedIn()
            && request.resource.data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clientId == request.auth.uid)
        );

      allow update: if signedIn()
        && belongsToUserShop(resource.data)
        && (
          // Another client asks for an open listing. One request at a time;
          // nothing moves until the holder approves.
          (resource.data.status == "open"
            && !swapHolder(resource.data)
            && request.resource.data.status == "requested"
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "requestedBy", "requestedByPhone", "requestedByEmail", "requestedAt"]))
          // The holder or the barber approves; the taker is the requester on file.
          || ((barberOwnsData(resource.data) || swapHolder(resource.data))
            && resource.data.status == "requested"
            && request.resource.data.status == "taken"
            && request.resource.data.takenBy == resource.data.requestedBy
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "takenBy", "takenByPhone", "takenAt"]))
          // The holder or the barber rejects, or the requester withdraws.
          || ((barberOwnsData(resource.data) || swapHolder(resource.data) || resource.data.requestedBy == request.auth.uid)
            && resource.data.status == "requested"
            && request.resource.data.status == "open"
            && request.resource.data.requestedBy == ""
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "requestedBy", "requestedByPhone", "requestedByEmail", "requestedAt"]))
        );

      // Only the holder or the barber may pull a listing off the board.
      allow delete: if barberOwnsData(resource.data)
        || swapHolder(resource.data);
    }

    match /services/{serviceId} {
      allow read: if signedIn() && belongsToUserShop(resource.data);
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }

    match /products/{productId} {
      allow read: if signedIn() && belongsToUserShop(resource.data);
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }

    match /gallery/{photoId} {
      allow read: if signedIn() && belongsToUserShop(resource.data);
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }

    match /broadcasts/{messageId} {
      allow read: if barberOwnsData(resource.data);
      allow create: if barberOwnsData(request.resource.data);
      allow update, delete: if barberOwnsData(resource.data);
    }
  }
}
